{
  "id": null,
  "uid": "kafka-performance-lab",
  "title": "Kafka Performance Lab",
  "tags": ["kafka", "performance"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {"id":1,"type":"timeseries","title":"Input received / sec","gridPos":{"h":8,"w":12,"x":0,"y":0},"targets":[{"expr":"rate(input_received_total[1m])","legendFormat":"input/s"}]},
    {"id":2,"type":"timeseries","title":"Output published / sec","gridPos":{"h":8,"w":12,"x":12,"y":0},"targets":[{"expr":"rate(output_published_total[1m])","legendFormat":"output/s"}]},
    {"id":3,"type":"timeseries","title":"Processing latency p95","gridPos":{"h":8,"w":12,"x":0,"y":8},"targets":[{"expr":"histogram_quantile(0.95, sum(rate(processing_duration_seconds_bucket[5m])) by (le))","legendFormat":"p95"}]},
    {"id":4,"type":"timeseries","title":"Failures and dead letters","gridPos":{"h":8,"w":12,"x":12,"y":8},"targets":[{"expr":"rate(processing_failed_total[1m])","legendFormat":"failures/s"},{"expr":"rate(dlt_total[1m])","legendFormat":"dlt/s"}]},
    {"id":5,"type":"timeseries","title":"JVM heap used","gridPos":{"h":8,"w":12,"x":0,"y":16},"targets":[{"expr":"jvm_memory_used_bytes{area=\"heap\"}","legendFormat":"heap"}]},
    {"id":6,"type":"timeseries","title":"Consumer lag (exporter dependent)","gridPos":{"h":8,"w":12,"x":12,"y":16},"targets":[{"expr":"kafka_consumer_fetch_manager_records_lag_max","legendFormat":"lag"}]}
  ]
}